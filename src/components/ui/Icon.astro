---
// Small inline icon set (all original drawings)
interface Props {
  name: 'search' | 'bolt' | 'leaf' | 'arrow-down' | 'instagram' | 'facebook' | 'youtube' | 'logo-mark';
  class?: string;
}
const { name, class: cls = '' } = Astro.props;
---
{name === 'search' && (
  <svg class={cls} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="6.8" cy="6.8" r="5.2" /><path d="m10.6 10.6 4 4" stroke-linecap="round" /></svg>
)}
{name === 'bolt' && (
  <svg class={cls} viewBox="0 0 14 16" fill="currentColor" aria-hidden="true"><path d="M8.6 0 0 9.3h5.6L4.4 16 14 6.2H8.2L8.6 0Z" /></svg>
)}
{name === 'leaf' && (
  <svg class={cls} viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M15.5.5C6 .5 1.5 4.6 1.5 10.4c0 1.3.3 2.5.8 3.6L.6 15.6l.9.9 1.7-1.7c1 .5 2.2.8 3.4.8 5.8 0 8.9-5.2 8.9-15.1ZM4 13.2c1.6-3.8 4.2-6.6 7.6-8.6-2.9 2.3-5 5.2-6.4 9.3L4 13.2Z" /></svg>
)}
{name === 'arrow-down' && (
  <svg class={cls} viewBox="0 0 24 22" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M2 8l10 11L22 8" stroke-linejoin="round" /></svg>
)}
{name === 'instagram' && (
  <svg class={cls} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="1" y="1" width="14" height="14" rx="4" /><circle cx="8" cy="8" r="3.3" /><circle cx="12.1" cy="3.9" r=".6" fill="currentColor" /></svg>
)}
{name === 'facebook' && (
  <svg class={cls} viewBox="0 0 12 20" fill="currentColor" aria-hidden="true"><path d="M7.8 20v-9h3l.5-3.6H7.8V5.2c0-1 .3-1.7 1.8-1.7h1.9V.3A25 25 0 0 0 8.7.1C6 .1 4.2 1.7 4.2 4.8v2.6H1.1V11h3.1v9h3.6Z" /></svg>
)}
{name === 'youtube' && (
  <svg class={cls} viewBox="0 0 20 14" fill="currentColor" aria-hidden="true"><path d="M19.6 2.2A2.5 2.5 0 0 0 17.8.4C16.3 0 10 0 10 0S3.7 0 2.2.4A2.5 2.5 0 0 0 .4 2.2C0 3.8 0 7 0 7s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C3.7 14 10 14 10 14s6.3 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8C20 10.2 20 7 20 7s0-3.2-.4-4.8ZM8 10V4l5.2 3L8 10Z" /></svg>
)}
{name === 'logo-mark' && (
  <svg class={cls} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 2c6 0 9.5 3.6 9.5 9.6C6.6 11.6 3 8 3 2Z" /><path d="M21 2c0 6-3.5 9.6-9.4 9.6C11.6 5.6 15 2 21 2Z" opacity=".75" /><path d="M12.5 12.4C12.5 18.4 9 22 3 22c0-6 3.6-9.6 9.5-9.6Z" opacity=".75" /><path d="M11.6 12.4c5.9 0 9.4 3.6 9.4 9.6-5.9 0-9.4-3.6-9.4-9.6Z" /></svg>
)}
