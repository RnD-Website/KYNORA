---
// HERO — 215vh scroll track with a sticky viewport.
// Layers (back→front): sky · background hills + birds · midground stone,
// products and hotspots · foreground grass. Motion lives in elements/hero.ts.
import Label from '../../ui/Label.astro';
import SplitTitle from '../../ui/SplitTitle.astro';
import Grass from './Grass.astro';
import ProductHotspot from './ProductHotspot.astro';
import { hero } from '../../../data/content';
---
<c-hero class="relative block h-[calc(var(--vh)*2.15)] xl:h-[215vh] bg-cream">
  <div class="hero-sticky sticky top-0 h-screen-mobile xl:h-screen pt-160 overflow-hidden">
    <!-- Sky -->
    <div class="hero-sky absolute-full opacity-0">
      <img src={hero.sky} alt="" class="cover" />
    </div>

    <!-- Copy -->
    <div class="hero-content content content-large grid-w w-full text-ink relative">
      <div class="col-span-full xl:col-start-4 xl:col-end-10 flex flex-col items-center">
        <div class="mb-30 md:mb-40">
          <Label text={hero.label} class="border-ink text-ink" manual />
        </div>
        <SplitTitle lines={hero.title} class="text-center md:-mx-[calc(var(--column)/2)]" manual tag="h1" />
        <p class="hero-copy body-s text-center mt-30 md:mt-40 max-w-[50rem]" data-reveal="copy" data-reveal-manual>{hero.copy}</p>
      </div>
    </div>

    <!-- Scene -->
    <div class="hero-layers absolute z-1 left-1/2 bottom-0 w-[200%] xl:w-full h-0 pt-[122%] md:pt-[90%] xl:pt-[62.5%] -translate-x-1/2">
      <div class="hero-layers-intro absolute-full">
        <!-- Background: hills + birds -->
        <div class="hero-background absolute-full pointer-events-none will-change-transform">
          <svg class="absolute-full" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
            <defs>
              <linearGradient id="hill-far" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#EFCFAE" /><stop offset="1" stop-color="#E6BD97" /></linearGradient>
              <linearGradient id="hill-mid" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#DDAA7E" /><stop offset="1" stop-color="#C98F63" /></linearGradient>
              <linearGradient id="field" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#C99A5A" /><stop offset="1" stop-color="#A9783F" /></linearGradient>
            </defs>
            <path d="M0 690 C140 640 260 600 400 628 C540 656 610 590 760 580 C900 570 980 640 1120 622 C1260 604 1380 560 1600 600 V1000 H0Z" fill="url(#hill-far)" />
            <path d="M0 760 C170 720 300 700 460 730 C640 764 760 700 920 712 C1080 724 1180 770 1340 742 C1460 722 1530 716 1600 724 V1000 H0Z" fill="url(#hill-mid)" />
            <path d="M0 830 C220 800 420 812 640 822 C860 832 1080 806 1300 812 C1440 816 1530 822 1600 826 V1000 H0Z" fill="url(#field)" />
            <g class="hero-birds" fill="#57382B">
              {[[260, 420, 1], [330, 470, 0.8], [210, 500, 0.9], [1190, 380, 0.85], [1250, 430, 1], [1330, 400, 0.7], [1120, 450, 0.75]].map(([x, y, sc]) => (
                <g class="bird" transform={`translate(${x} ${y}) scale(${sc})`}>
                  <path class="bird-wings" d="M-18 -4 Q-9 -10 0 2 Q9 -10 18 -4 Q9 -4 0 6 Q-9 -4 -18 -4Z" />
                </g>
              ))}
            </g>
          </svg>
          <Grass side="left" seed={11} clumps={14} height={420} spread={460} tone="far" />
          <Grass side="right" seed={29} clumps={14} height={420} spread={460} tone="far" />
        </div>

        <!-- Midground: stone pedestal, products, hotspots -->
        <div class="hero-midground absolute-full will-change-transform">
          <svg class="absolute-full pointer-events-none" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
            <defs>
              <linearGradient id="stone" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#E7CDB0" /><stop offset=".35" stop-color="#D2B08D" /><stop offset="1" stop-color="#A9825F" /></linearGradient>
              <linearGradient id="stone-top" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F3E1CB" /><stop offset="1" stop-color="#DCC0A0" /></linearGradient>
            </defs>
            <path d="M300 1000 C310 950 318 900 352 866 C380 838 430 826 500 820 C560 806 640 812 700 804 C780 796 860 808 940 800 C1020 794 1100 810 1170 818 C1230 826 1262 850 1280 890 C1294 930 1300 968 1310 1000Z" fill="url(#stone)" />
            <path d="M360 858 C392 834 440 826 500 822 C560 810 640 814 700 806 C780 798 860 810 940 802 C1020 796 1100 812 1168 820 C1210 826 1240 840 1256 858 C1180 846 1100 840 980 842 C860 846 760 838 640 842 C540 845 450 850 360 858Z" fill="url(#stone-top)" />
            <g stroke="#9C7553" stroke-width="2" fill="none" opacity=".35">
              <path d="M420 900 l40 -12 l30 18 l46 -8" /><path d="M640 950 l26 -22 l40 6" /><path d="M980 908 l34 14 l26 -16 l44 8" /><path d="M1120 960 l30 -26" /><path d="M520 980 l60 -18" />
            </g>
          </svg>
          <div class="hero-shadow absolute left-[31%] w-[40%] bottom-[15.6%] h-[4%] pointer-events-none" style="background: radial-gradient(50% 50% at 50% 50%, rgb(60 35 20 / .45), rgb(60 35 20 / 0) 70%); scale: var(--product-scale, 1); transform-origin: 50% 0;" aria-hidden="true"></div>
          <img class="hero-product hero-product-left absolute w-[21%] left-[33%] bottom-[17.6%] origin-bottom" style="scale: var(--product-scale, 1); translate: calc(var(--product-gap, 0) * -1%) 0;" src={hero.products.left.image} alt="KYNORA Creatine Monohydrate, orange" />
          <img class="hero-product hero-product-right absolute w-[17%] left-[50.6%] bottom-[17.6%] origin-bottom" style="scale: var(--product-scale, 1); translate: calc(var(--product-gap, 0) * 1%) 0;" src={hero.products.right.image} alt="KYNORA product family, brown" />
          <ProductHotspot side="left" label={hero.products.left.label} href={hero.products.left.href} icon="bolt" class="top-[40%] left-[34%] md:top-[47%] md:left-[36.2%]" />
          <ProductHotspot side="right" label={hero.products.right.label} href={hero.products.right.href} icon="leaf" class="top-[57%] right-[33%] md:top-[54%] md:right-[34.2%]" />
        </div>

        <!-- Foreground: near grass -->
        <div class="hero-foreground absolute-full pointer-events-none will-change-transform">
          <Grass side="left" seed={7} clumps={16} height={760} spread={420} tone="near" />
          <Grass side="left" seed={41} clumps={4} height={880} spread={160} tone="front" />
          <Grass side="right" seed={53} clumps={16} height={760} spread={420} tone="near" />
          <Grass side="right" seed={67} clumps={4} height={880} spread={160} tone="front" />
          <!-- dense turf row across the bottom, in front of the stone -->
          <Grass side="full" seed={91} clumps={46} height={150} spread={1600} tone="near" />
          <Grass side="full" seed={113} clumps={30} height={90} spread={1600} tone="front" />
        </div>
      </div>
    </div>
  </div>
</c-hero>

<script>
  import '../../../elements/hero';
</script>
