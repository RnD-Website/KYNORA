---
import '../styles/global.css';
import Header from '../components/layout/Header';
import Logo from '../components/ui/Logo.astro';
import { nav, brand } from '../data/content';

interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#F4E9D9" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Heading font (League Gothic, closest free match to the reference's TT Bluescreens) from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=League+Gothic&display=swap" />
    <title>{title}</title>
  </head>
  <body>
    <!-- Loader (reference: .loader) -->
    <div class="loader fixed inset-0 bg-cream z-loader flex-center">
      <div class="loader-logo overflow-hidden text-ink">
        <div class="loader-logo-inner"><Logo class="w-[22rem] md:w-[18rem] h-auto" /></div>
      </div>
    </div>

    <Header client:load primary={nav.primary} secondary={nav.secondary} region={nav.region} />

    <main class="lenis">
      <div class="page-wrapper">
        <slot />
      </div>
      <slot name="footer" />
    </main>

    <div class="orientation-lock fixed inset-0 z-loader bg-cream flex-center heading-h7 text-ink text-center px-margin">
      Rotate your device to portrait mode.
    </div>

    <script>
      import { initScroll, gsap, ScrollTrigger } from '../lib/scroll';
      import { initReveals } from '../lib/reveal';
      import { setReady } from '../lib/app';

      import { onTune, hexToRgb } from '../lib/tune';

      // DialKit "Global" panel: palette, smooth-scroll weight, page margin
      onTune('global', (v) => {
        const root = document.documentElement;
        for (const [name, hex] of Object.entries(v.colors as Record<string, string>)) {
          root.style.setProperty(`--rgb-${name}`, hexToRgb(hex));
        }
        root.style.setProperty('--margin', `${v.pageMargin}rem`);
        const l = (window as any).lenis;
        if (l) l.options.lerp = v.smoothScroll;
      });

      const lenis = initScroll();
      lenis.stop();
      window.scrollTo(0, 0);
      initReveals();

      const loader = document.querySelector<HTMLElement>('.loader')!;
      const inner = loader.querySelector('.loader-logo-inner');
      const tl = gsap.timeline();
      tl.fromTo(inner, { yPercent: 110 }, { yPercent: 0, duration: 0.9, ease: 'expo.out' });

      Promise.all([document.fonts.ready, new Promise((r) => (document.readyState === 'complete' ? r(null) : window.addEventListener('load', r, { once: true })))]).then(() => {
        gsap.timeline({ delay: Math.max(0, 0.9 - tl.time()) })
          .to(inner, { yPercent: -110, duration: 0.7, ease: 'expo.in' })
          .to(loader, { yPercent: -100, duration: 1.1, ease: 'expo.inOut' }, '-=0.2')
          .add(() => setReady(), '-=0.7')
          .add(() => {
            loader.style.display = 'none';
            lenis.start();
            ScrollTrigger.refresh();
          });
      });
    </script>
  </body>
</html>
